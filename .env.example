# Servidor
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200

# YGOPRODeck
YGOPRODECK_BASE_URL=https://db.ygoprodeck.com/api/v7
# Limite oficial da API é 20 req/s por IP; deixamos folga (ver bottleneck em ygoprodeck.service.ts)
YGOPRODECK_MAX_CONCURRENT=5
YGOPRODECK_MIN_TIME_MS=100

# Cache local das respostas de cardinfo.php (TTL em segundos)
CARD_CACHE_TTL=172800

# Cloudinary (para re-hospedar as imagens, conforme exigido pelo guia da YGOPRODeck)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=yugioh-tcg
