{
  "name": "yugioh-tcg-api",
  "version": "0.1.0",
  "description": "API em Fastify que consulta o YGOPRODeck e re-hospeda as imagens das cartas no Cloudinary",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "bottleneck": "^2.19.5",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
